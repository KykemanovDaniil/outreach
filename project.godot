; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OUTREACH"
config/version="1.2.5"
run/main_scene="uid://dupck2ruambx6"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=129
run/frame_delay_msec=1
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

SaveSystem="*uid://o8r58etebsl1"
GlobalValues="*uid://cg3rjhqafapw4"
TextAnim="*uid://15iirxi7mxvl"
Hotkeys="*uid://cowhos0ruavq8"
Debug="*uid://b2diochwpjlb"
SoundManager="*uid://dvrtibcoxgkh4"
WindowManager="*uid://ckdvu7jhhl6kf"
DebugDraw="*uid://by86urffsm5ab"
ButtonManager="*uid://bim73s7c4gscr"

[debug]

settings/physics_interpolation/enable_warnings=false

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray()

[global_group]

