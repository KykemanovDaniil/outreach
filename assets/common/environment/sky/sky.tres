[gd_resource type="ShaderMaterial" format=3 uid="uid://b0653msc61pmn"]

[sub_resource type="Shader" id="Shader_23og5"]
code = "shader_type spatial;

// unshaded для производительности, cull_disabled чтобы видеть снизу и сверху
render_mode unshaded, blend_mix, cull_disabled, shadows_disabled, fog_disabled;

uniform sampler2D noise_tex : source_color, filter_nearest; 
uniform float threshold : hint_range(0.0, 1.0) = 0.5;
uniform float cloud_scale : hint_range(0.00007, 0.005) = 0.0004;
uniform vec2 speed = vec2(0.05, 0.05);
uniform vec4 cloud_color : source_color = vec4(1.0);

// --- ДИСТАНЦИЯ ---
uniform float fade_distance : hint_range(100.0, 500000.0) = 50000.0;
uniform float fade_start : hint_range(0.0, 400000.0) = 500.0;

varying vec3 world_pos;

void vertex() {
    // Получаем позицию в мире, чтобы облака не \"плавали\" при движении меша
    world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
    // 1. Координаты на основе мира (убирает рябь и привязывает шум к сетке)
    vec2 moving_uv = (world_pos.xz * cloud_scale) + (TIME * speed);
    
    // 2. Чтение шума
    float n = texture(noise_tex, moving_uv).r;
    
    // 3. Маска (Minecraft-style резкость)
    float mask = step(threshold, n);
    
    // 4. Дистанция затухания (чтобы не было резкого края меша)
    float dist = distance(world_pos.xz, CAMERA_POSITION_WORLD.xz);
    float fade = 1.0 - smoothstep(fade_start, fade_distance, dist);
    
    // 5. Цвет и Альфа
    ALBEDO = cloud_color.rgb;
    ALPHA = mask * cloud_color.a * fade;

    // Важно: отсекаем пустые пиксели для корректной сортировки слоев
    if (ALPHA < 0.01) discard;
}
"

