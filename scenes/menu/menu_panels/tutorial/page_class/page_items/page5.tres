[resource]
script = ExtResource("1_bpad3")
PAGE_NAME = "Ticks"
PAGE_DESCRIPTION = "Random Ticks:
A dynamic system that breathes life into the infinite world of Outreach. It handles real-time simulation of random events within a specific radius of the player, making the environment feel reactive and evolving.

Performance-Driven Simulation:
To maintain the game's high performance, the system only processes a specific number of random voxels per frame within the player's vicinity. This ensures a living world without compromising generation speed or stability."
metadata/_custom_type_script = "uid://bvymcx0bbfpbj"
